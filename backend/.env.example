# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=3000
# NODE_ENV=production   # in production JWT_SECRET and SESSION_SECRET are required
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
# Comma-separated list of allowed frontend origins (leave empty in development)
CORS_ORIGINS=
# KIDSCODE_DB_PATH=./codequest.db

# --- AI coach ---
# Leave everything below empty to run fully OFFLINE (built-in verified content).
# AI_PROVIDER=anthropic | openai | offline   (auto-detected if omitted)

# Option A: Claude (Anthropic API)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5        # fast, low-cost default
# ANTHROPIC_VERSION=2023-06-01

# Option B: any OpenAI-compatible server, e.g. Ollama on a school server
# OPENAI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1
# OPENAI_API_KEY=

# --- Cost and safety limits ---
AI_MAX_CALLS_PER_LEARNER_PER_HOUR=60
AI_TIMEOUT_MS=20000
# How many cached variants of each AI activity to keep (more = more variety, more cost)
AI_CACHE_VARIANTS=4
SANDBOX_MAX_CONCURRENT=4
